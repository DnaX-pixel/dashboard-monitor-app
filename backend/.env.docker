# Server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# MySQL Database — set automatically by docker-compose.yml env block
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=dashboard_monitor
# DB_USER=monitor_user
# DB_PASS=monitor_pass

# Email (SMTP) — leave blank to skip email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Ollama OCR — in Docker, set automatically in docker-compose.yml
# OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=minicpm-v4.6
