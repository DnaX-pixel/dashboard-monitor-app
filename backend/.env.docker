# Server
PORT=3001
JWT_SECRET=change-me-to-a-long-random-string

# Email (SMTP) — leave blank to skip email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Ollama OCR — in Docker, this is set automatically in docker-compose.yml
# OLLAMA_URL=http://ollama:11434
OLLAMA_VISION_MODEL=minicpm-v4.6